{
  "name": "after-hours-party-games",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Six real-time party games for friends, built with plain JavaScript and Node.js.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node --check server.js && node --check public/app.js && node --check public/account-ui.js",
    "check:backend": "node scripts/check-backend.mjs",
    "seed:sql": "node scripts/seed-supabase.js --sql",
    "test:backend": "node --test test/backend.test.js test/database.test.js",
    "test": "node --test test/*.test.js",
    "test:ui": "playwright test",
    "test:load": "node test/load.mjs",
    "test:packed": "node --test test/packed.test.js",
    "test:exhaustive": "node test/packed-exhaustive.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.0"
  }
}

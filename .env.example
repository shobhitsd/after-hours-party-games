# Copy to .env. Start with: node --env-file=.env server.js
# Empty cloud settings keep standalone local play working.
PORT=3000
PUBLIC_ORIGIN=

# Supabase Project Settings -> API. Server secrets NEVER belong in public/.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY also work.

# Upstash Redis -> REST API. Required for Vercel and multiple Node instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Razorpay test mode first. Create a monthly INR plan for 9900 paise, interval 1.
PAYMENTS_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
# Live keys are rejected unless PAYMENTS_MODE=live is explicitly set.

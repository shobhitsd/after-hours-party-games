# Optional local use: copy to .env and run node --env-file=.env server.js
PORT=3000
NODE_ENV=production
PUBLIC_ORIGIN=https://after-hours-party-games.vercel.app

# ==========================================
# 1. Supabase Database & Storage Config
# ==========================================
# Find these in your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ==========================================
# 2. Payment Gateway (₹99/mo Host Pass)
# ==========================================
# Razorpay (India: UPI AutoPay, Cards, Net Banking)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_PLAN_ID=plan_xxxxxxxxxxxx # ₹99/month subscription plan
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret

# Stripe (Global / USD Fallback: $2.99/mo)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

